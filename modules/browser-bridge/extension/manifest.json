{
  "manifest_version": 3,
  "name": "BCT Browser Bridge (Prototype)",
  "version": "0.0.2",
  "description": "Opt-in read-only ChatGPT local relay; source-only prototype, not production.",
  "permissions": ["nativeMessaging", "storage", "activeTab"],
  "action": {"default_popup": "popup.html"},
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/c/*"],
      "js": ["chat_protocol.js", "chat_content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "key": ""
}
