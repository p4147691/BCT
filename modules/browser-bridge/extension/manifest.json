{
  "manifest_version": 3,
  "name": "BCT Browser Bridge",
  "version": "0.1.0",
  "description": "Independent BCT control transport for exact ChatGPT conversations.",
  "permissions": ["nativeMessaging", "storage", "tabs"],
  "action": {"default_popup": "popup.html"},
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://chatgpt.com/c/*"],
    "js": ["tool_protocol.js", "chat_tools.js"],
    "run_at": "document_idle"
  }],
  "key": ""
}
