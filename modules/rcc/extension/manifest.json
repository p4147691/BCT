{
  "manifest_version": 3,
  "name": "BCT RCC",
  "version": "1.0.45",
  "version_name": "1.0.45 Legacy Manager Retirement",
  "description": "BCT browser conversation control with fenced Project Run relay, idempotent new-chat bootstrap, conversation rename, and read-only diagnostics.",
  "key": "",
  "permissions": [
    "scripting",
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background_loader.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BCT RCC"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "relay_core.js",
        "content/conversation_dom.js",
        "content/simple_relay_executor.js",
        "content/orchestration_relay_executor.js",
        "content/conversation_rename.js",
        "content/content_router.js",
        "content/activity_reporter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
