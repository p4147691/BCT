{
  "schema": "bct.component-library.v1",
  "version": 1,
  "coverage": "curated-not-exhaustive",
  "kind_definitions": {
    "primitive": "One smallest verified read, effect, or atomic state transition.",
    "module": "A reusable capability with a stable input and output contract.",
    "partial_recipe": "A reusable ordered composition that still needs a caller decision or another recipe.",
    "full_recipe": "A user-visible end-to-end composition with completion and recovery boundaries."
  },
  "maturity_definitions": {
    "isolated": "Own source file and focused contract test.",
    "bounded": "Clear callable boundary but shares a larger source module.",
    "embedded": "Reusable function boundary still embedded in a large recipe module."
  },
